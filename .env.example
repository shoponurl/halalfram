APP_NAME="Halal Brothers"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=halal_farm_store
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# --- Sprint 09: hardening & launch (see docs/runbook.md) ---
# Production: DB_USERNAME=halal_app (no DROP/ALTER) and a separate migration user for deploys/backups
# DB_MIGRATE_USERNAME=halal_migrate
# DB_MIGRATE_PASSWORD=
# Load balancer / CDN IPs in front of the app, or * (leave empty if PHP gets traffic directly)
TRUSTED_PROXIES=
# Production: true
# SESSION_SECURE_COOKIE=true

# Soft launch: store pickup plus these delivery zips only, no nationwide shipping
SOFT_LAUNCH=false
SOFT_LAUNCH_DELIVERY_ZIPS=

# Alerts reach a real person. Production: LOG_STACK=daily,alerts
LOG_SLACK_WEBHOOK_URL=
LOG_SLACK_LEVEL=critical
ALERT_EMAIL=

# Encrypted backups (ops:backup / ops:restore-drill). Keep the passphrase in a password manager too.
BACKUP_PASSPHRASE=
BACKUP_KEEP=14
BACKUP_MYSQLDUMP_BINARY=mysqldump
BACKUP_MYSQL_BINARY=mysql
BACKUP_GPG_BINARY=gpg
RESTORE_DRILL_DATABASE=halal_restore_drill

# Key rotation: put the old APP_KEY here when rotating, so staff 2FA secrets still decrypt
APP_PREVIOUS_KEYS=
